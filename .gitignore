Plugins/*/Intermediate/

# Local developer-only content
Content/Developers/

# Temporary files and logs
*.log
*.tmp
*.temp
*.bak
*.swp
*~

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

